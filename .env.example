PORT=3140
# Configure LLM explicitly in the local web UI. No environment Key fallback.
# Strava OAuth App credentials (operator only):
# STRAVA_CLIENT_ID=
# STRAVA_CLIENT_SECRET=
# GARMIN_PERSONAL_API_KEY=
# intervals.icu (primary data source): Settings > Developer Settings > API key, and your athlete id (e.g. i12345)
# INTERVALS_API_KEY=
# INTERVALS_ATHLETE_ID=
