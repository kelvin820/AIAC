{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/build-demo.mjs --cloud",
  "outputDirectory": "dist",
  "rewrites": [
    {"source": "/api/:operation", "destination": "/api/aiac?operation=:operation"}
  ],
  "crons": [
    {"path": "/api/cron", "schedule": "0 21 * * *"}
  ],
  "headers": [
    {"source": "/(.*)", "headers": [
      {"key": "X-Content-Type-Options", "value": "nosniff"},
      {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"},
      {"key": "Content-Security-Policy", "value": "default-src 'self'; style-src 'self'; script-src 'self'; connect-src 'self'; img-src 'self' https://tile.openstreetmap.org; frame-ancestors 'none'; base-uri 'none'"}
    ]}
  ]
}
